    "@types/chai-as-promised": "^7.1.4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^9.0.13",
    "@types/mocha": "^8.2.3",
    "@types/node": "^16.3.1",
    "@typescript-eslint/eslint-plugin": "^4.28.3",
    "@typescript-eslint/parser": "^4.28.3",
